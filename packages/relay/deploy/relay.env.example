# Copy to /etc/girru-relay/relay.env and set your own name.
# Devices sign this exact address in their hello, so it must match what the
# computer and the phone app are configured to dial.
GIRRU_RELAY_URL=wss://relay.example.org/v1

# Keep the relay on loopback; the TLS proxy in front of it is the only way in.
GIRRU_RELAY_HOST=127.0.0.1
GIRRU_RELAY_PORT=41540

# Optional limits (defaults shown).
#GIRRU_RELAY_MAX_ENVELOPE_BYTES=1048576
#GIRRU_RELAY_MESSAGES_PER_SECOND=50
#GIRRU_RELAY_BYTES_PER_SECOND=4194304
#GIRRU_RELAY_MAX_CONNECTIONS=10000
