FROM node:24.21.0-bookworm-slim AS base

FROM base AS backend-deps
WORKDIR /app/packages/backend
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY packages/backend/package.json packages/backend/package-lock.json packages/backend/.npmrc ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM base AS ui
WORKDIR /app/packages/core-ui
COPY packages/core-ui/package.json packages/core-ui/package-lock.json packages/core-ui/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY packages/core-ui ./
COPY packages/display-renderer ../display-renderer
RUN node scripts/build.cjs --candidate --live-entry && chmod -R a+rX dist

FROM base AS runtime
WORKDIR /app/packages/backend
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python-is-python3 python3-venv ffmpeg && rm -rf /var/lib/apt/lists/*
COPY packages/backend/python-scripts/requirements.txt /tmp/python-requirements.txt
RUN python3 -m venv /opt/girru-python && /opt/girru-python/bin/pip install --no-cache-dir -r /tmp/python-requirements.txt
ENV PATH="/opt/girru-python/bin:${PATH}" NODE_ENV=production \
    AGENT_PLAYER_DATA_DIR=/app/.data STORAGE_BASE_DIR=/app/public/storage
COPY --from=backend-deps /app/packages/backend/node_modules ./node_modules
COPY packages/backend/package.json packages/backend/package-lock.json packages/backend/tsconfig.json ./
COPY packages/backend/src ./src
COPY packages/backend/skills ./skills
COPY packages/backend/extensions ./extensions
COPY packages/backend/python-scripts ./python-scripts
COPY packages/identity/src/memory-native-proof.cjs packages/identity/src/memory-native-owner-wire.cjs ../identity/src/
COPY packages/desktop/src/backend-process.cjs packages/desktop/src/setup-code.cjs ../desktop/src/
COPY packages/core-ui/package.json ../core-ui/
COPY packages/core-ui/scripts ../core-ui/scripts
COPY packages/core-ui/src ../core-ui/src
COPY --from=ui /app/packages/core-ui/dist ../core-ui/dist
COPY public /app/public
COPY scripts/docker/start.cjs scripts/docker/setup.cjs /app/scripts/docker/
# Keep the numeric owner used by the previous image, including existing named volumes.
RUN groupadd -g 1001 girru && useradd -u 1001 -g girru -m girru && \
    install -d -m 0700 -o girru -g girru /app/.data /app/public/storage
USER girru
EXPOSE 41522
HEALTHCHECK --interval=10s --timeout=5s --start-period=60s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:41522/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "/app/scripts/docker/start.cjs"]
